# =========================================================
# Elastic Stack
# =========================================================
STACK_VERSION=9.5.4

# =========================================================
# Elasticsearch
# =========================================================
# Password for the built-in elastic superuser.
# Generate with: openssl rand -hex 24
ELASTIC_PASSWORD=REPLACE_WITH_RANDOM_HEX

# =========================================================
# Kibana
# =========================================================
# Password for the built-in kibana_system user.
# Generate with: openssl rand -hex 24
KIBANA_PASSWORD=REPLACE_WITH_RANDOM_HEX

# =========================================================
# Logstash
# =========================================================
# Password for the dedicated Logstash writer account.
# Generate with: openssl rand -hex 24
LOGSTASH_WRITER_PASSWORD=REPLACE_WITH_RANDOM_HEX

# =========================================================
# Kibana encryption keys
# =========================================================
# Generate each with: openssl rand -hex 32
KIBANA_SECURITY_ENCRYPTION_KEY=REPLACE_WITH_RANDOM_64_CHAR_HEX
KIBANA_SAVED_OBJECTS_ENCRYPTION_KEY=REPLACE_WITH_RANDOM_64_CHAR_HEX
KIBANA_REPORTING_ENCRYPTION_KEY=REPLACE_WITH_RANDOM_64_CHAR_HEX